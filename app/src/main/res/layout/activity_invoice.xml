<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Invoice Pesanan"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- KARTU NOTA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detail Pesanan"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvInvoiceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invoice #INV-12345" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginVertical="12dp" />

            <TextView
                android:id="@+id/tvInvoiceTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: Rp 7.700.000"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- TOMBOL RATING -->
        <Button
            android:id="@+id/btnBeriRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Beri Rating &amp; Ulasan"
            android:backgroundTint="#B89B5E"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include layout="@layout/view_header" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Langkah 1 dari 3 · Data &amp; layanan" android:textColor="@color/muted" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp" android:orientation="horizontal">
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@color/gold" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@color/line" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/line" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
                <TextView style="@style/Lbl" android:layout_marginTop="0dp" android:text="Nama lengkap" />
                <EditText android:id="@+id/etName" style="@style/Input" android:hint="Nama sesuai identitas" android:importantForAutofill="no" android:inputType="textPersonName|textCapWords" />

                <TextView style="@style/Lbl" android:text="No. telepon" />
                <EditText android:id="@+id/etEmail" style="@style/Input" android:hint="081234567890" android:importantForAutofill="no" android:inputType="phone" />

                <TextView style="@style/Lbl" android:text="Alamat" />
                <EditText android:id="@+id/etAddress" style="@style/Input" android:hint="Alamat lengkap" android:importantForAutofill="no" android:inputType="textPostalAddress|textMultiLine" android:minLines="2" />

                <TextView style="@style/Lbl" android:text="Merek &amp; Tipe Mobil" />
                <EditText android:id="@+id/etCar" style="@style/Input" android:hint="Contoh: Toyota Avanza" android:importantForAutofill="no" android:inputType="textCapWords" />

                <TextView style="@style/Lbl" android:text="Plat Nomor" />
                <EditText android:id="@+id/etPlate" style="@style/Input" android:hint="Contoh: B 1234 XYZ" android:importantForAutofill="no" android:inputType="textCapCharacters" />

                <TextView style="@style/Lbl" android:text="Layanan" />
                <RadioGroup android:id="@+id/rgService" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />

                <TextView style="@style/Lbl" android:text="Catatan (warna, material, request)" />
                <EditText android:id="@+id/etNote" style="@style/Input" android:hint="Warna hitam, jahitan merah" android:importantForAutofill="no" android:inputType="textCapSentences|textMultiLine" android:minLines="2" />

                <TextView style="@style/Lbl" android:text="Tanggal antar mobil" />
                <EditText android:id="@+id/etDate" style="@style/Input" android:cursorVisible="false" android:focusable="false" android:hint="Pilih tanggal" android:importantForAutofill="no" android:inputType="none" />

                <TextView style="@style/Lbl" android:text="Jam antar" />
                <Spinner android:id="@+id/spTime" style="@style/Input" android:paddingEnd="8dp" android:paddingStart="8dp" />

                <CheckBox android:id="@+id/cbPickup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Minta mobil dijemput ke alamat (biaya dikonfirmasi)" android:textSize="12sp" />
                <CheckBox android:id="@+id/cbTerms" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saya setuju dengan syarat &amp; ketentuan" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_gold_strip" android:orientation="vertical" android:padding="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total estimasi" android:textColor="@color/ink" android:textSize="12sp" />
                <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DP 50% dibayar sekarang" android:textColor="@color/ink" android:textSize="12sp" />
                <TextView android:id="@+id/tvDp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Harga final dikonfirmasi Vertue sebelum pembayaran diproses." android:textColor="@color/muted" android:textSize="10sp" />
        </LinearLayout>
        <Button android:id="@+id/btnNext" style="@style/Btn.Gold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Lanjut ke pembayaran DP" />
    </LinearLayout>
</LinearLayout>
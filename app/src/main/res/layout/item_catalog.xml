<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

    <View android:id="@+id/divider" android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="14dp" android:background="#EEE9DD" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/tvCatName" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvCatPrice" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:textColor="@color/gold" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/tvCatDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:textColor="@color/muted" android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <FrameLayout android:layout_width="28dp" android:layout_height="match_parent">
        <View android:id="@+id/line" android:layout_width="2dp" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" />
        <View android:id="@+id/dot" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center_horizontal|top" android:layout_marginTop="3dp" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="18dp" android:paddingStart="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvStepTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/chipNow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_pill_navy" android:paddingBottom="2dp" android:paddingEnd="8dp" android:paddingStart="8dp" android:paddingTop="2dp" android:text="SEDANG BERJALAN" android:textColor="@color/white" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/tvStepSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" />
        <LinearLayout android:id="@+id/photos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:visibility="gone">
            <TextView android:layout_width="72dp" android:layout_height="56dp" android:background="@drawable/bg_photo" android:gravity="center" android:text="Foto pola" android:textColor="@color/muted" android:textSize="10sp" />
            <TextView android:layout_width="72dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:background="@drawable/bg_photo" android:gravity="center" android:text="Foto jahitan" android:textColor="@color/muted" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvRatingOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Bagaimana hasil pengerjaannya?"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView android:id="@+id/star1" style="@style/StarItem" />
                <TextView android:id="@+id/star2" style="@style/StarItem" />
                <TextView android:id="@+id/star3" style="@style/StarItem" />
                <TextView android:id="@+id/star4" style="@style/StarItem" />
                <TextView android:id="@+id/star5" style="@style/StarItem" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStarLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/gold"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Lbl"
                android:text="APA YANG KAMU SUKA? (OPSIONAL)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/chipRapi"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Hasil rapi" />

                <CheckBox
                    android:id="@+id/chipWaktu"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Tepat waktu" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/chipKomunikasi"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Komunikasi baik" />

                <CheckBox
                    android:id="@+id/chipHarga"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Harga sesuai" />
            </LinearLayout>

            <TextView
                style="@style/Lbl"
                android:text="ULASAN (OPSIONAL)" />

            <EditText
                android:id="@+id/etReview"
                style="@style/Input"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="Ceritakan pengalamanmu..."
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="110dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnSubmitRating"
            style="@style/Btn.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kirim rating" />
    </LinearLayout>
</LinearLayout>
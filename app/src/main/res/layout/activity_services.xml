<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/servicesRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <include android:id="@+id/headerRoot" layout="@layout/view_header" />

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <RadioGroup android:id="@+id/catGroup" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="16dp"
            android:paddingEnd="8dp" android:paddingBottom="12dp" />
    </HorizontalScrollView>

    <ScrollView android:id="@+id/servicesScroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp">

            <LinearLayout android:id="@+id/catalogList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:lineSpacingExtra="3dp"
                android:paddingStart="4dp" android:paddingEnd="4dp"
                android:text="Harga bisa berbeda tergantung jenis mobil dan bahan. Hubungi workshop untuk penawaran yang pasti."
                android:textColor="@color/muted" android:textSize="12sp" />

            <Button android:id="@+id/btnOrderNow" style="@style/Btn.Navy" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Buat Pesanan" />
            <Button android:id="@+id/btnContact" style="@style/Btn.Outline" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Hubungi workshop" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>